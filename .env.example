ENVIRONMENT=local
START_WORKER=false
AWS_REGION=us-east-1
GUARDRAILS_ENABLED=false
API_KEY=local-dev-key
PYRIT_AUTH_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:8000

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/researchdb
TENSORZERO_URL=http://tensorzero:3000

# Required for live web research. Wikipedia works without a key.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
FIRECRAWL_ALLOWED_DOMAINS=
FIRECRAWL_ALLOWED_PATHS=
WIKIPEDIA_ENABLED=true
SEARCH_MAX_RESULTS=5
MAX_TOOL_CALLS=8
TOOL_RATE_LIMIT_PER_MINUTE=30
TOOL_TIMEOUT=30
FIRECRAWL_MAX_PAGES=3
FIRECRAWL_MAX_DEPTH=0

# Set true only when exact-query report reuse is desired.
CACHE_REPORTS=false
CACHE_TTL=3600

WORKER_CONCURRENCY=2
JOB_TIMEOUT=600
JOB_MAX_RETRIES=2
JOB_CLAIM_IDLE_MS=120000

GEMINI_API_KEY=
GROQ_API_KEY=
